embeddings/
embeddings_demo/
*.npy
*.faiss

# Trained models (can be retrained)
models/
*.pth
*.pkl

# Logs and outputs
*.log
wandb/
tensorboard/
legacy/

# OS
.DS_Store
Thumbs.db

# Keep directory structure
!data/.gitkeep
!embeddings/.gitkeep
!models/.gitkeep
